APP_ENV=development

# PostgreSQL — pre-seeded automatically from docker/postgres/init/ on first start
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/chargeback

# LLM Gateway (gemini-2.5-flash-lite is recommended)
LLM_PROVIDER=google
LLM_API_KEY=your-gemini-key-here
LLM_MODEL=gemini-2.5-flash-lite

# Gemini embeddings and Gemini LLM share the same key
GOOGLE_API_KEY=your-gemini-key-here

# LangSmith observability (optional — leave blank to disable)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chargeback-intelligence

# Deadline abstraction: dispute_opened_at + N days
DISPUTE_DEADLINE_DAYS=30

# Logging
LOG_LEVEL=INFO

APP_ENV=development

# PostgreSQL (matches docker-compose service name)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/chargeback

# LLM Gateway (set provider name and corresponding API key)
LLM_PROVIDER=
LLM_API_KEY=

# LangSmith observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chargeback-intelligence

# Kaggle API credentials (for downloading Phase 1 datasets)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Deadline abstraction: dispute_opened_at + N days
DISPUTE_DEADLINE_DAYS=30

# Logging
LOG_LEVEL=INFO
